<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/SongItemLayout"
    android:layout_width="fill_parent"
    android:layout_height="60.0dip"
    android:foreground="?selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@id/drag_handle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10.0dip"
        android:contentDescription="@string/app_name"
        android:src="@drawable/bt_reorder" />

    <CheckBox
        android:id="@id/SongItemCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="15.0dip"
        android:button="@drawable/btn_check"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <ImageView
        android:id="@id/SongItemIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15.0dip"
        android:layout_marginTop="5.0dip"
        android:layout_marginRight="15.0dip"
        android:layout_marginBottom="5.0dip"
        android:contentDescription="@string/app_name"
        android:scaleType="center" />

    <LinearLayout
        android:layout_width="0.0dip"
        android:layout_height="60.0dip"
        android:layout_marginRight="5.0dip"
        android:layout_weight="1.0"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@id/SongItemTitle"
            style="@style/TextView_Title.OverDark"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical" />

        <TextView
            android:id="@id/SongItemSubTitle"
            style="@style/TextView_Description.OverDark"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageView
        android:id="@id/SongItemShortCut"
        android:layout_width="48.0dip"
        android:layout_height="48.0dip"
        android:layout_gravity="end|center"
        android:background="?selectableItemBackgroundBorderless"
        android:padding="12.0dip"
        android:scaleType="centerInside"
        android:src="@drawable/bt_select_v" />
</LinearLayout>