<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/container_detail_album_back"
        android:layout_width="match_parent"
        android:layout_height="@dimen/container_detail_album_back_size"
        android:alpha="0.65"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_detail"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/content_cover"
                android:layout_width="@dimen/main_container_detail_cover_size"
                android:layout_height="@dimen/main_container_detail_cover_size"
                android:src="@drawable/thumbnail_song"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true"/>
            <ImageView
                android:layout_width="@dimen/main_container_detail_cover_border_size"
                android:layout_height="@dimen/main_container_detail_cover_border_size"
                android:src="@drawable/canvas_detail"
                android:scaleType="fitXY"
                android:layout_centerInParent="true"
                android:contentDescription="@string/app_name"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content_bigcover_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/content_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextView_Description.OverLight"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:id="@+id/content_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextView_Description.OverLight"/>
            <TextView
                android:textColor="@color/white"
                android:id="@+id/content_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextView_Description.OverLight"/>
            <include
                android:id="@+id/content_rating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/rating_indicator"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>