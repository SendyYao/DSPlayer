<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <include
        android:visibility="gone"
        android:layout_marginRight="@dimen/player_quick_control_action_space"
        layout="@layout/player_btn_prev" />

    <include
        android:visibility="visible"
        layout="@layout/player_btn_play" />

    <include
        android:visibility="visible"
        android:layout_marginLeft="@dimen/player_quick_control_action_space"
        layout="@layout/player_btn_next" />

    <include
        android:visibility="gone"
        android:layout_marginLeft="@dimen/player_quick_control_action_space"
        layout="@layout/player_btn_stop" />
</LinearLayout>