<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/PlayingControlPanel_SeekBarPanel"
    android:layout_width="fill_parent"
    android:layout_height="52.0dip">

    <include
        android:id="@+id/PlayingControlPanel_SeekBar"
        layout="@layout/seekbar_track_match_parrent"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/PlayingControlPanel_PlayingTime"
        style="@style/TextView_PlayingTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginLeft="10.0dip"
        android:layout_marginBottom="8.0dip" />

    <TextView
        android:id="@+id/PlayingControlPanel_Duration"
        style="@style/TextView_DurationLength"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginRight="10.0dip"
        android:layout_marginBottom="8.0dip" />
</FrameLayout>